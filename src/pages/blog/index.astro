---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import { getCollection } from "astro:content";

const posts = (
  await getCollection(
    "blog",
    ({ id, data }) => !data.draft && id.toLowerCase() !== "readme"
  )
).sort((a, b) => {
  const da = a.data.date?.getTime() ?? 0;
  const db = b.data.date?.getTime() ?? 0;
  return db - da;
});

function titleOf(post: (typeof posts)[number]) {
  return post.data.title || post.id.replace(/[-_]/g, " ");
}
---

<Base title="Blog — Claudia Roussel">
  <Header />
  <main class="page">
    <h1>Blog</h1>
    {
      posts.length === 0 ? (
        <p class="empty">No posts yet. Drop a Markdown file into <code>blog/</code>. See <code>blog/README.md</code>.</p>
      ) : (
        <div class="blog-list">
          {posts.map((post) => (
            <a class="blog-item" href={`/blog/${post.id}`}>
              <time datetime={post.data.date?.toISOString()}>
                {post.data.date
                  ? post.data.date.toLocaleDateString("en-GB", {
                      day: "numeric",
                      month: "short",
                      year: "numeric",
                    })
                  : "No date"}
              </time>
              <div>
                <h2>{titleOf(post)}</h2>
                {post.data.description && <p>{post.data.description}</p>}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </main>
</Base>
