---
interface Props {
  intro?: boolean;
}

const { intro = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/services", label: "Services" },
  { href: "/", label: "Projects" },
  { href: "/claudia", label: "Claudia" },
  { href: "/blog", label: "Blog" },
];
---

<header class="site-header">
  <a class="logo" href="/" aria-label="Claudia Roussel">
    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="1.2"></circle>
      <g stroke="currentColor" stroke-width="1.1">
        <line x1="21" y1="16" x2="28.5" y2="16"></line>
        <line x1="20.62" y1="17.91" x2="27.55" y2="20.87"></line>
        <line x1="19.54" y1="19.54" x2="24.95" y2="24.95"></line>
        <line x1="17.91" y1="20.62" x2="20.87" y2="27.55"></line>
        <line x1="16" y1="21" x2="16" y2="28.5"></line>
        <line x1="14.09" y1="20.62" x2="11.13" y2="27.55"></line>
        <line x1="12.46" y1="19.54" x2="7.05" y2="24.95"></line>
        <line x1="11.38" y1="17.91" x2="4.45" y2="20.87"></line>
        <line x1="11" y1="16" x2="3.5" y2="16"></line>
        <line x1="11.38" y1="14.09" x2="4.45" y2="11.13"></line>
        <line x1="12.46" y1="12.46" x2="7.05" y2="7.05"></line>
        <line x1="14.09" y1="11.38" x2="11.13" y2="4.45"></line>
        <line x1="16" y1="11" x2="16" y2="3.5"></line>
        <line x1="17.91" y1="11.38" x2="20.87" y2="4.45"></line>
        <line x1="19.54" y1="12.46" x2="24.95" y2="7.05"></line>
        <line x1="20.62" y1="14.09" x2="27.55" y2="11.13"></line>
      </g>
    </svg>
  </a>

  {
    intro && (
      <p class="intro">
        Placeholder. A short line on how Claudia works, who she works with, and what she cares about. Replace this with a real introduction.
      </p>
    )
  }
  {!intro && <div></div>}

  <div class="nav-wrap" data-nav>
    <button class="menu-toggle" type="button" aria-label="Menu" data-menu>
      <span></span>
      <span></span>
    </button>
    <nav class="nav">
      {
        links.map((link) => (
          <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="cta" href="/contact">Get in Touch</a>
  </div>
</header>

<script>
  const wrap = document.querySelector("[data-nav]");
  const button = document.querySelector("[data-menu]");
  button?.addEventListener("click", () => wrap?.classList.toggle("open"));
</script>
